---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Disponibilidad del equipo' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{title}</title>
</head>
<body>
  <header class="app-header">
    <h1>📅 Disponibilidad del equipo</h1>
    <nav>
      <a href="/">Inicio</a>
      <a href="/disponibilidad" id="nav-disponibilidad" class="hidden">Mi disponibilidad</a>
      <a href="/resumen">Resumen</a>
    </nav>
    <script is:inline>
      if (localStorage.getItem('participant')) {
        document.getElementById('nav-disponibilidad')?.classList.remove('hidden');
      }
    </script>
  </header>
  <div class="flag-stripe"><span></span><span></span><span></span><span></span><span></span></div>
  <main>
    <slot />
  </main>
</body>
</html>