---
import Layout from '../layouts/Layout.astro';
import { getAllParticipants } from '../lib/db';

const participants = await getAllParticipants();

function initials(name: string) {
  const parts = name.trim().split(/\s+/);
  const first = parts[0]?.[0] ?? '';
  const last = parts.length > 1 ? parts[parts.length - 1][0] : '';
  return (first + last).toUpperCase();
}
---
<Layout title="Cago verde">
  {participants.length > 0 ? (
    <>
      <div class="card">
        <h2>¿Quién eres?</h2>
        <p class="hint">Toca tu nombre para marcar tu disponibilidad.</p>
        <div class="player-grid">
          {participants.map((p) => (
            <button type="button" class="player-btn" data-id={p.id} data-name={p.name}>
              <span class="player-avatar">{initials(p.name)}</span>
              <span class="player-name">{p.name}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="card add-player-card">
        <button type="button" id="toggle-add-btn" class="link-muted" aria-expanded="false">
          + No estoy en la lista, agregar mi nombre
        </button>
        <div id="add-form" class="hidden">
          <div class="form-group" style="margin-top: 14px;">
            <label for="name">Nombre</label>
            <input type="text" id="name" placeholder="Ej. Carlos" maxlength="40" autocomplete="name" />
          </div>
          <button id="continue-btn">Agregar y continuar</button>
          <p id="error-msg" class="hint" style="color: var(--color-danger); display:none;"></p>
        </div>
      </div>
    </>
  ) : (
    <div class="card">
      <h2>Sé el primero en registrarte</h2>
      <p class="hint">Todavía nadie se ha registrado. Escribe tu nombre para empezar.</p>
      <div id="add-form">
        <div class="form-group">
          <label for="name">Nombre</label>
          <input type="text" id="name" placeholder="Ej. Carlos" maxlength="40" autocomplete="name" />
        </div>
        <button id="continue-btn">Agregar y continuar</button>
        <p id="error-msg" class="hint" style="color: var(--color-danger); display:none;"></p>
      </div>
    </div>
  )}
</Layout>

<script>
  type Participant = { id: string; name: string };

  function selectParticipant(participant: Participant) {
    localStorage.setItem('participant', JSON.stringify(participant));
    window.location.href = '/disponibilidad';
  }

  document.querySelectorAll<HTMLButtonElement>('.player-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      selectParticipant({ id: btn.dataset.id!, name: btn.dataset.name! });
    });
  });

  const toggleBtn = document.getElementById('toggle-add-btn') as HTMLButtonElement | null;
  const addForm = document.getElementById('add-form') as HTMLDivElement | null;

  toggleBtn?.addEventListener('click', () => {
    const isHidden = addForm?.classList.contains('hidden');
    addForm?.classList.toggle('hidden');
    toggleBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    if (isHidden) {
      document.getElementById('name')?.focus();
    }
  });

  const submitBtn = document.getElementById('continue-btn') as HTMLButtonElement | null;
  const input = document.getElementById('name') as HTMLInputElement | null;
  const errorMsg = document.getElementById('error-msg') as HTMLParagraphElement | null;

  async function submitName() {
    if (!input || !submitBtn || !errorMsg) return;
    const name = input.value.trim();
    errorMsg.style.display = 'none';

    if (!name) {
      errorMsg.textContent = 'Por favor escribe tu nombre.';
      errorMsg.style.display = 'block';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Guardando...';

    try {
      const res = await fetch('/api/participantes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Error al registrar');

      selectParticipant(data);
    } catch (err: any) {
      errorMsg.textContent = err.message || 'Ocurrió un error, intenta de nuevo.';
      errorMsg.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Agregar y continuar';
    }
  }

  submitBtn?.addEventListener('click', submitName);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') submitName();
  });
</script>